#safira 0.9
# 🦘 スーパージャンプ
# 出力をクリック。Space を押し続けてため、離すとジャンプ。Esc で終了。

力 = 0
棒 = ""
表示 "Space を押し続けてためよう!"

条件ループ 真 {
    もし 押した Esc なら プログラム終了

    もし 押している Space なら {
        増やす 1 em 力
        棒 = 棒 + "🟩"
        画面消去
        表示 棒
    }

    とき 離した Space {
        表示 "🦘 % メートルのジャンプ!" 埋め込み 力
        鳴らす C5, E5, G5 長さ 100ミリ秒
        力 = 0
        棒 = ""
    }

    待つ 100 ミリ秒
}
