#safira 0.9
# 🏁 スタートシグナル

表示 "ドライバーの名前は?"
選手 = 入力
ランプ = ""

関数 点灯() {
    ランプ = ランプ + "🔴"
    画面消去
    表示 ランプ
    鳴らす C 長さ 300ミリ秒
    待つ 1秒
}

繰り返す 5 回 {
    点灯()
}

間 = 乱数 1 から 3
待つ 間 秒
画面消去

もし 間 大なり 2 なら 表示 "長いな!"
表示 "🟢 スタート, " + 選手 + "!" 色 緑
鳴らす C5, E5, G5 長さ 200ミリ秒

リスト 表彰台 は "Max", "Lia"
追加 選手 リスト先頭 表彰台

順番に 表彰台 取り出す 車 {
    表示 "🏆 " + 車
}
