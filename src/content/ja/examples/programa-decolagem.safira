#safira 0.9
# 🚀 ロケット発射

リスト ロケット は "        /\", "       /  \", "      | ** |", "      | ** |", "     /|    |\", "    /_|____|_\"
リスト 炎1 は "       (**)", "        ()"
リスト 炎2 は "      ( ** )", "       (())", "        ()"
リスト 星 は "  *        .     *   .", "       .      *       ", " .     *          .   ", "    *       .        *"

関数 空(総数) {
    数える 行番号 を 1 から 総数 {
        表示 リスト 星 位置 (行番号 % 4 + 1) 色 灰色い
    }
}

関数 場面(上段, 火) {
    画面消去
    空(上段)

    順番に ロケット 取り出す 部品 {
        表示 部品 色 青
    }

    もし 火 等しい 1 なら {
        順番に 炎1 取り出す 部品 {
            表示 部品 色 オレンジ
        }
    } そうでなければ {
        順番に 炎2 取り出す 部品 {
            表示 部品 色 黄色い
        }
    }
}

関数 秒読み(数値) {
    場面(6, 1)
    表示 ""
    表示 "        >> " + 数値 + " <<" 色 赤
    鳴らす C 長さ 200ミリ秒
    待つ 700 ミリ秒
}

秒読み(3)
秒読み(2)
秒読み(1)
鳴らす C5, E5, G5 長さ 120ミリ秒

繰り返す 2 回 {
    場面(6, 1)
    鳴らす C3 長さ 90ミリ秒
    場面(6, 2)
    鳴らす C3 長さ 90ミリ秒
}

数える 高さ を 6 から 0 {
    場面(高さ, 高さ % 2)
    鳴らす G3, C4 長さ 60ミリ秒
}

鳴らす E5 長さ 90ミリ秒
画面消去
表示 ""
表示 "        .  *  .        " 色 白
待つ 120 ミリ秒
画面消去
表示 ""
表示 "     *  . \ | / .  *   " 色 黄色い
表示 "    .  --  ** --  .    " 色 オレンジ
表示 "     *  . / | \ .  *   " 色 黄色い
鳴らす G5, C6 長さ 100ミリ秒
画面消去
表示 ""
表示 "  *   .   \  |  /   .   *" 色 黄色い
表示 "   .   ---  ***  ---   . " 色 赤
表示 "  *   .   /  |  \   .   *" 色 黄色い
鳴らす E6, G6 長さ 100ミリ秒
画面消去
表示 ""
表示 ""
続けて表示 "   S" 色 #3ddcff
鳴らす C5 長さ 120ミリ秒
続けて表示 "  A" 色 青
鳴らす E5 長さ 120ミリ秒
続けて表示 "  F" 色 紫
鳴らす G5 長さ 120ミリ秒
続けて表示 "  I" 色 ピンク
鳴らす A5 長さ 120ミリ秒
続けて表示 "  R" 色 オレンジ
鳴らす C6 長さ 120ミリ秒
続けて表示 "  A" 色 黄色い
鳴らす E6 長さ 400ミリ秒
表示 ""
