#safira 0.9
# 🦖 恐竜ジャンプ
# 実行して出力をクリック。Space か上で跳び、Esc で終了。

記録 = 0
リスト 弧 は 1, 2, 2, 2, 1

関数 再開() {
    サボテン1 = 16
    サボテン2 = 26
    雲 = 14
    跳躍 = 0
    高さ = 0
    得点 = 0
    生存 = 真
    間隔 = 90
}

関数 区画(c, 段階) {
    もし c == 3 かつ 段階 == 高さ なら 返す "🦖"
    もし 段階 == 0 かつ c == サボテン1 なら 返す "🌵"
    もし 段階 == 0 かつ c == サボテン2 なら 返す "🌵"
    もし 段階 == 2 かつ c == 雲 なら 返す "☁️"
    返す "⬛"
}

関数 行描画(段階) {
    文字 = ""

    数える c を 1 から 16 {
        文字 = 文字 + 区画(c, 段階)
    }

    表示 文字
}

関数 描画() {
    画面消去
    表示 "🦖 得点: " + 得点 + "   🏆 記録: " + 記録
    行描画(2)
    行描画(1)
    行描画(0)
    表示 "🟫🟫🟫🟫🟫🟫🟫🟫🟫🟫🟫🟫🟫🟫🟫🟫"

    もし 生存 == 偽 なら 表示 "💥 ゲームオーバー!Enter を押そう。" na cor vermelho
}

関数 前進() {
    サボテン1 = サボテン1 - 1
    サボテン2 = サボテン2 - 1
    雲 = 雲 - 1
    得点 = 得点 + 1

    もし サボテン1 < 1 なら サボテン1 = サボテン2 + 乱数 8 から 16
    もし サボテン2 < 1 なら サボテン2 = サボテン1 + 乱数 8 から 16
    もし 雲 < 1 なら 雲 = 16

    もし 跳躍 > 0 なら {
        高さ = リスト 弧 位置 跳躍
        跳躍 = 跳躍 - 1
    } そうでなければ {
        高さ = 0
    }

    もし 得点 % 50 == 0 かつ 間隔 > 40 なら {
        間隔 = 間隔 - 10
        鳴らす C6 長さ 40ミリ秒
    }

    もし 高さ == 0 かつ サボテン1 == 3 なら 生存 = 偽
    もし 高さ == 0 かつ サボテン2 == 3 なら 生存 = 偽

    もし 生存 == 偽 なら {
        もし 得点 > 記録 なら 記録 = 得点
        鳴らす E4, C4 長さ 120ミリ秒
    }
}

再開()
描画()

条件ループ 真 {
    もし 押した Esc なら プログラム終了

    もし 押した Space または 押した 上 なら {
        もし 生存 かつ 跳躍 == 0 かつ 高さ == 0 なら {
            跳躍 = 5
            鳴らす E5 長さ 30ミリ秒
        }
    }

    もし 生存 なら {
        前進()
        描画()
    } そうでなければ {
        もし 押した Enter なら {
            再開()
            描画()
        }
    }

    待つ 間隔 ミリ秒
}
