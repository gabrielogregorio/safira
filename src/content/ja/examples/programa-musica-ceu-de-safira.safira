#safira 0.9
# 🎵 サファイアの空

関数 和音() {
    鳴らす A4, C5, E5, C5 長さ 150ミリ秒
    鳴らす F4, A4, C5, A4 長さ 150ミリ秒
    鳴らす G4, C5, E5, C5 長さ 150ミリ秒
    鳴らす G4, B4, D5, B4 長さ 150ミリ秒
}

関数 歌() {
    鳴らす E5, R, E5, D5 長さ 200ミリ秒
    鳴らす C5 長さ 400ミリ秒
    鳴らす D5, E5, C5, A4 長さ 200ミリ秒
    鳴らす R 長さ 200ミリ秒
    鳴らす A4, C5, D5, E5 長さ 200ミリ秒
    鳴らす G5 長さ 400ミリ秒
    鳴らす E5, D5 長さ 200ミリ秒
    鳴らす C5 長さ 600ミリ秒
}

関数 サビ() {
    鳴らす A5, G5, E5, G5 長さ 150ミリ秒
    鳴らす A5 長さ 450ミリ秒
    鳴らす C6, A5, G5, E5 長さ 150ミリ秒
    鳴らす D5 長さ 450ミリ秒
    鳴らす E5, G5, A5, C6 長さ 150ミリ秒
    鳴らす D6 長さ 300ミリ秒
    鳴らす C6, B5 長さ 150ミリ秒
    鳴らす A5 長さ 600ミリ秒
}

関数 終わり() {
    鳴らす E5, D5, C5, B4 長さ 150ミリ秒
    鳴らす A4 長さ 300ミリ秒
    鳴らす A4, E5, A5 長さ 150ミリ秒
    鳴らす A5 長さ 900ミリ秒
}

画面消去
表示 "サファイアの空" 色 #3ddcff

表示 "🌊" 色 青
繰り返す 2 回 {
    和音()
}

表示 "🌱" 色 緑
歌()
和音()

表示 "✨" 色 #ffd24a
繰り返す 2 回 {
    サビ()
}

表示 "🌱" 色 緑
歌()

表示 "💎" 色 紫
終わり()

表示 "おわり 🎵"
