#safira 0.9
# ⚔️ ミニ RPG
# 出力をクリック。矢印か WASD で歩き、Esc で終了。
# 魔物に向かって歩くと攻撃します。


リスト 地図 は "###########", "#.........#", "#.##...##.#", "#.#..#..#.#", "#...###...#", "#.#.....#.#", "###########"
リスト 魔物_x は 0, 0, 0
リスト 魔物_y は 0, 0, 0
リスト 魔物_体力 は 0, 0, 0

関数 開始() {
    勇者_x = 2
    勇者_y = 2
    体力 = 10
    鍵あり = 偽
    薬あり = 真
    プレイ中 = 真
    伝言 = "🗝️ を見つけて 🚪 から逃げよう"
    リスト 魔物_x 位置 1 = 6
    リスト 魔物_y 位置 1 = 3
    リスト 魔物_体力 位置 1 = 3
    リスト 魔物_x 位置 2 = 10
    リスト 魔物_y 位置 2 = 2
    リスト 魔物_体力 位置 2 = 3
    リスト 魔物_x 位置 3 = 5
    リスト 魔物_y 位置 3 = 6
    リスト 魔物_体力 位置 3 = 5
}

関数 壁判定(px, py) {
    地図段 = リスト 地図 位置 py
    返す 地図段[px:px] == "#"
}

関数 魔物判定(px, py) {
    数える m を 1 から 3 {
        生存 = リスト 魔物_体力 位置 m
        mx = リスト 魔物_x 位置 m
        my = リスト 魔物_y 位置 m

        もし 生存 > 0 かつ mx == px かつ my == py なら {
            返す m
        }
    }

    返す 0
}

関数 図柄(cx, cy) {
    もし cx == 勇者_x かつ cy == 勇者_y なら 返す "🧙"
    もし 魔物判定(cx, cy) > 0 なら 返す "👹"
    もし cx == 10 かつ cy == 6 かつ 鍵あり == 偽 なら 返す "🗝️"
    もし cx == 6 かつ cy == 2 かつ 薬あり なら 返す "🧪"
    もし cx == 2 かつ cy == 6 なら 返す "🚪"
    もし 壁判定(cx, cy) なら 返す "🧱"
    返す "⬛"
}

関数 描画() {
    画面消去
    鍵印 = "❌"
    もし 鍵あり なら 鍵印 = "✅"
    表示 "⚔️ ミニ RPG   ❤️ " + 体力 + "   🗝️ " + 鍵印

    数える cy を 1 から 7 {
        文字段 = ""

        数える cx を 1 から 11 {
            文字段 = 文字段 + 図柄(cx, cy)
        }

        表示 文字段
    }

    表示 伝言 色 黄色い
}

関数 攻撃(標的) {
    威力 = 乱数 1 から 3
    残り = リスト 魔物_体力 位置 標的
    リスト 魔物_体力 位置 標的 = 残り - 威力
    鳴らす C5 長さ 80ミリ秒

    もし 残り - 威力 > 0 なら {
        伝言 = "" + 威力 + " のダメージ!魔物はまだ倒れない。"
    } そうでなければ {
        伝言 = "魔物を倒した!⚔️"
        鳴らす E5, G5 長さ 80ミリ秒
    }
}

関数 魔物移動() {
    数える n を 1 から 3 {
        強さ = リスト 魔物_体力 位置 n

        もし 強さ > 0 なら {
            向き = 乱数 1 から 4
            ox = リスト 魔物_x 位置 n
            oy = リスト 魔物_y 位置 n
            もし 向き == 1 なら ox = ox + 1
            もし 向き == 2 なら ox = ox - 1
            もし 向き == 3 なら oy = oy + 1
            もし 向き == 4 なら oy = oy - 1

            もし ox == 勇者_x かつ oy == 勇者_y なら {
                体力 = 体力 - 1
                伝言 = "魔物の攻撃を受けた!💥"
                鳴らす C3 長さ 100ミリ秒
            } そうでなくもし 壁判定(ox, oy) == 偽 かつ 魔物判定(ox, oy) == 0 なら {
                リスト 魔物_x 位置 n = ox
                リスト 魔物_y 位置 n = oy
            }
        }
    }
}

関数 歩く(dx, dy) {
    新_x = 勇者_x + dx
    新_y = 勇者_y + dy
    標的 = 魔物判定(新_x, 新_y)

    もし 標的 > 0 なら {
        攻撃(標的)
    } そうでなくもし 壁判定(新_x, 新_y) == 偽 なら {
        勇者_x = 新_x
        勇者_y = 新_y
        伝言 = "..."
    }

    もし 勇者_x == 6 かつ 勇者_y == 2 かつ 薬あり なら {
        薬あり = 偽
        体力 = 体力 + 5
        伝言 = "薬だ!体力 +5 🧪"
        鳴らす G5, C6 長さ 80ミリ秒
    }

    もし 勇者_x == 10 かつ 勇者_y == 6 かつ 鍵あり == 偽 なら {
        鍵あり = 真
        伝言 = "鍵を手に入れた!🗝️"
        鳴らす E5, G5, C6 長さ 80ミリ秒
    }

    魔物移動()

    もし 体力 <= 0 なら {
        プレイ中 = 偽
        伝言 = "力尽きた…… Enter でもう一度。"
        鳴らす E4, C4, A3 長さ 200ミリ秒
    }

    もし 勇者_x == 2 かつ 勇者_y == 6 かつ 鍵あり なら {
        プレイ中 = 偽
        伝言 = "脱出成功!🏆 Enter でもう一度。"
        鳴らす C5, E5, G5, C6 長さ 150ミリ秒
    }

    描画()
}

開始()
描画()

条件ループ 真 {
    もし 押した Esc なら プログラム終了

    もし プレイ中 なら {
        もし 押した 上 または 押した W なら 歩く(0, -1)
        もし 押した 下 または 押した S なら 歩く(0, 1)
        もし 押した 左 または 押した A なら 歩く(-1, 0)
        もし 押した 右 または 押した D なら 歩く(1, 0)
    } そうでなければ {
        とき 離した Enter {
            開始()
            描画()
        }
    }

    待つ 30 ミリ秒
}
