#safira 0.9
# 🕵️ Código secreto

muestra "Escribe un mensaje:"
guarda la respuesta en mensaje

reemplace "a" con "4" en la variable mensaje
reemplace "e" con "3" en la variable mensaje
reemplace "o" con "0" en la variable mensaje

muestra "🕵️ En código: " + mensaje
muestra mensaje en mayusculas en color verde
muestra "Primera letra: " + mensaje[1:1]
