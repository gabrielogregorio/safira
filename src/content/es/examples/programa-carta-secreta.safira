#safira 0.9
# 💣 Carta que se autodestruye

crea el archivo "carta.txt"
sobrescribir "La clave es 4815" al archivo "carta.txt"

si el archivo "carta.txt" existe entonces muestra lea el archivo "carta.txt"

para cada cuenta desde 3 hasta 1 {
    muestra "💣 " + cuenta en color rojo
    esperar 1 segundos
}

eliminar el archivo "carta.txt"
si el archivo "carta.txt" no existe entonces muestra "💥 ¡Carta destruida!"
