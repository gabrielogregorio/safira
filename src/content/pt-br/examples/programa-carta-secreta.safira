#safira 0.9
# 💣 Carta que se autodestrói

crie o arquivo "carta.txt"
sobrescreva "A senha é 4815" no arquivo "carta.txt"

se o arquivo "carta.txt" existe então mostre leia o arquivo "carta.txt"

para cada segundo_final de 3 até 1 {
    mostre "💣 " + segundo_final na cor vermelho
    espere 1 segundo
}

delete o arquivo "carta.txt"
se o arquivo "carta.txt" não existe então mostre "💥 Carta destruída!"
