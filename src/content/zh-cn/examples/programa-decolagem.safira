#safira 0.9
# 🚀 火箭发射

列表 火箭 包含 "        /\", "       /  \", "      | ** |", "      | ** |", "     /|    |\", "    /_|____|_\"
列表 火焰1 包含 "       (**)", "        ()"
列表 火焰2 包含 "      ( ** )", "       (())", "        ()"
列表 星星 包含 "  *        .     *   .", "       .      *       ", " .     *          .   ", "    *       .        *"

函数 天空(总数) {
    对于 行号 从 1 到 总数 {
        显示 列表 星星 位置 (行号 % 4 + 1) 颜色 灰色
    }
}

函数 画面(上方, 火) {
    清屏
    天空(上方)

    遍历 火箭 放入 部分 {
        显示 部分 颜色 蓝色
    }

    如果 火 等于 1 那么 {
        遍历 火焰1 放入 部分 {
            显示 部分 颜色 橙色
        }
    } 否则 {
        遍历 火焰2 放入 部分 {
            显示 部分 颜色 黄色
        }
    }
}

函数 倒数(数值) {
    画面(6, 1)
    显示 ""
    显示 "        >> " + 数值 + " <<" 颜色 红色
    播放 C 持续 200毫秒
    等待 700 毫秒
}

倒数(3)
倒数(2)
倒数(1)
播放 C5, E5, G5 持续 120毫秒

重复 2 次 {
    画面(6, 1)
    播放 C3 持续 90毫秒
    画面(6, 2)
    播放 C3 持续 90毫秒
}

对于 高度 从 6 到 0 {
    画面(高度, 高度 % 2)
    播放 G3, C4 持续 60毫秒
}

播放 E5 持续 90毫秒
