#safira 0.9
# 🦖 小恐龙
# 运行后点击输出区。Space 或上键跳跃,Esc 退出。

纪录 = 0
列表 弧线 包含 1, 2, 2, 2, 1

函数 重来() {
    仙人掌1 = 16
    仙人掌2 = 26
    云朵 = 14
    跳跃 = 0
    高度 = 0
    分数 = 0
    存活 = 真
    间隔 = 90
}

函数 方块(c, 层级) {
    如果 c == 3 并且 层级 == 高度 那么 返回 "🦖"
    如果 层级 == 0 并且 c == 仙人掌1 那么 返回 "🌵"
    如果 层级 == 0 并且 c == 仙人掌2 那么 返回 "🌵"
    如果 层级 == 2 并且 c == 云朵 那么 返回 "☁️"
    返回 "⬛"
}

函数 画行(层级) {
    文字 = ""

    对于 c 从 1 到 16 {
        文字 = 文字 + 方块(c, 层级)
    }

    显示 文字
}

函数 绘制() {
    清屏
    显示 "🦖 分数:" + 分数 + "   🏆 纪录:" + 纪录
    画行(2)
    画行(1)
    画行(0)
    显示 "🟫🟫🟫🟫🟫🟫🟫🟫🟫🟫🟫🟫🟫🟫🟫🟫"

    如果 存活 == 假 那么 显示 "💥 游戏结束!按 Enter。" na cor vermelho
}

函数 前进() {
    仙人掌1 = 仙人掌1 - 1
    仙人掌2 = 仙人掌2 - 1
    云朵 = 云朵 - 1
    分数 = 分数 + 1

    如果 仙人掌1 < 1 那么 仙人掌1 = 仙人掌2 + 随机数 8 到 16
    如果 仙人掌2 < 1 那么 仙人掌2 = 仙人掌1 + 随机数 8 到 16
    如果 云朵 < 1 那么 云朵 = 16

    如果 跳跃 > 0 那么 {
        高度 = 列表 弧线 位置 跳跃
        跳跃 = 跳跃 - 1
    } 否则 {
        高度 = 0
    }

    如果 分数 % 50 == 0 并且 间隔 > 40 那么 {
        间隔 = 间隔 - 10
        播放 C6 持续 40毫秒
    }

    如果 高度 == 0 并且 仙人掌1 == 3 那么 存活 = 假
    如果 高度 == 0 并且 仙人掌2 == 3 那么 存活 = 假

    如果 存活 == 假 那么 {
        如果 分数 > 纪录 那么 纪录 = 分数
        播放 E4, C4 持续 120毫秒
    }
}

重来()
绘制()

当 真 {
    如果 按下 Esc 那么 结束程序

    如果 按下 Space 或者 按下 上 那么 {
        如果 存活 并且 跳跃 == 0 并且 高度 == 0 那么 {
            跳跃 = 5
            播放 E5 持续 30毫秒
        }
    }

    如果 存活 那么 {
        前进()
        绘制()
    } 否则 {
        如果 按下 Enter 那么 {
            重来()
            绘制()
        }
    }

    等待 间隔 毫秒
}
