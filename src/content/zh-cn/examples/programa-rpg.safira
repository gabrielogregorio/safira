#safira 0.9
# ⚔️ 迷你 RPG
# 点击输出区。方向键或 WASD 移动,Esc 退出。
# 走向怪物就是攻击。


列表 地图 包含 "###########", "#.........#", "#.##...##.#", "#.#..#..#.#", "#...###...#", "#.#.....#.#", "###########"
列表 怪物_x 包含 0, 0, 0
列表 怪物_y 包含 0, 0, 0
列表 怪物_生命 包含 0, 0, 0

函数 开局() {
    英雄_x = 2
    英雄_y = 2
    生命 = 10
    有钥匙 = 假
    有药水 = 真
    游戏中 = 真
    消息 = "找到 🗝️ 然后从 🚪 逃走"
    列表 怪物_x 位置 1 = 6
    列表 怪物_y 位置 1 = 3
    列表 怪物_生命 位置 1 = 3
    列表 怪物_x 位置 2 = 10
    列表 怪物_y 位置 2 = 2
    列表 怪物_生命 位置 2 = 3
    列表 怪物_x 位置 3 = 5
    列表 怪物_y 位置 3 = 6
    列表 怪物_生命 位置 3 = 5
}

函数 是墙(px, py) {
    地图行 = 列表 地图 位置 py
    返回 地图行[px:px] == "#"
}

函数 怪物位置(px, py) {
    对于 m 从 1 到 3 {
        存活 = 列表 怪物_生命 位置 m
        mx = 列表 怪物_x 位置 m
        my = 列表 怪物_y 位置 m

        如果 存活 > 0 并且 mx == px 并且 my == py 那么 {
            返回 m
        }
    }

    返回 0
}

函数 图标(cx, cy) {
    如果 cx == 英雄_x 并且 cy == 英雄_y 那么 返回 "🧙"
    如果 怪物位置(cx, cy) > 0 那么 返回 "👹"
    如果 cx == 10 并且 cy == 6 并且 有钥匙 == 假 那么 返回 "🗝️"
    如果 cx == 6 并且 cy == 2 并且 有药水 那么 返回 "🧪"
    如果 cx == 2 并且 cy == 6 那么 返回 "🚪"
    如果 是墙(cx, cy) 那么 返回 "🧱"
    返回 "⬛"
}

函数 绘制() {
    清屏
    钥匙标记 = "❌"
    如果 有钥匙 那么 钥匙标记 = "✅"
    显示 "⚔️ 迷你 RPG   ❤️ " + 生命 + "   🗝️ " + 钥匙标记

    对于 cy 从 1 到 7 {
        文字行 = ""

        对于 cx 从 1 到 11 {
            文字行 = 文字行 + 图标(cx, cy)
        }

        显示 文字行
    }

    显示 消息 颜色 黄色
}

函数 攻击(目标) {
    伤害 = 随机数 1 到 3
    剩余 = 列表 怪物_生命 位置 目标
    列表 怪物_生命 位置 目标 = 剩余 - 伤害
    播放 C5 持续 80毫秒

    如果 剩余 - 伤害 > 0 那么 {
        消息 = "造成 " + 伤害 + " 点伤害!怪物还活着。"
    } 否则 {
        消息 = "怪物被打败了!⚔️"
        播放 E5, G5 持续 80毫秒
    }
}

函数 移动怪物() {
    对于 n 从 1 到 3 {
        力量 = 列表 怪物_生命 位置 n

        如果 力量 > 0 那么 {
            方向 = 随机数 1 到 4
            ox = 列表 怪物_x 位置 n
            oy = 列表 怪物_y 位置 n
            如果 方向 == 1 那么 ox = ox + 1
            如果 方向 == 2 那么 ox = ox - 1
            如果 方向 == 3 那么 oy = oy + 1
            如果 方向 == 4 那么 oy = oy - 1

            如果 ox == 英雄_x 并且 oy == 英雄_y 那么 {
                生命 = 生命 - 1
                消息 = "怪物打中了你!💥"
                播放 C3 持续 100毫秒
            } 否则如果 是墙(ox, oy) == 假 并且 怪物位置(ox, oy) == 0 那么 {
                列表 怪物_x 位置 n = ox
                列表 怪物_y 位置 n = oy
            }
        }
    }
}

函数 行走(dx, dy) {
    新_x = 英雄_x + dx
    新_y = 英雄_y + dy
    目标 = 怪物位置(新_x, 新_y)

    如果 目标 > 0 那么 {
        攻击(目标)
    } 否则如果 是墙(新_x, 新_y) == 假 那么 {
        英雄_x = 新_x
        英雄_y = 新_y
        消息 = "..."
    }

    如果 英雄_x == 6 并且 英雄_y == 2 并且 有药水 那么 {
        有药水 = 假
        生命 = 生命 + 5
        消息 = "药水!生命 +5 🧪"
        播放 G5, C6 持续 80毫秒
    }

    如果 英雄_x == 10 并且 英雄_y == 6 并且 有钥匙 == 假 那么 {
        有钥匙 = 真
        消息 = "你拿到了钥匙!🗝️"
        播放 E5, G5, C6 持续 80毫秒
    }

    移动怪物()

    如果 生命 <= 0 那么 {
        游戏中 = 假
        消息 = "你倒下了……按 Enter 再试一次。"
        播放 E4, C4, A3 持续 200毫秒
    }

    如果 英雄_x == 2 并且 英雄_y == 6 并且 有钥匙 那么 {
        游戏中 = 假
        消息 = "你逃出来了!🏆 按 Enter 再玩一次。"
        播放 C5, E5, G5, C6 持续 150毫秒
    }

    绘制()
}

开局()
绘制()

当 真 {
    如果 按下 Esc 那么 结束程序

    如果 游戏中 那么 {
        如果 按下 上 或者 按下 W 那么 行走(0, -1)
        如果 按下 下 或者 按下 S 那么 行走(0, 1)
        如果 按下 左 或者 按下 A 那么 行走(-1, 0)
        如果 按下 右 或者 按下 D 那么 行走(1, 0)
    } 否则 {
        在 松开 Enter {
            开局()
            绘制()
        }
    }

    等待 30 毫秒
}
