#safira 0.9
# 🎵 蓝宝石天空

函数 和弦() {
    播放 A4, C5, E5, C5 持续 150毫秒
    播放 F4, A4, C5, A4 持续 150毫秒
    播放 G4, C5, E5, C5 持续 150毫秒
    播放 G4, B4, D5, B4 持续 150毫秒
}

函数 主歌() {
    播放 E5, R, E5, D5 持续 200毫秒
    播放 C5 持续 400毫秒
    播放 D5, E5, C5, A4 持续 200毫秒
    播放 R 持续 200毫秒
    播放 A4, C5, D5, E5 持续 200毫秒
    播放 G5 持续 400毫秒
    播放 E5, D5 持续 200毫秒
    播放 C5 持续 600毫秒
}

函数 副歌() {
    播放 A5, G5, E5, G5 持续 150毫秒
    播放 A5 持续 450毫秒
    播放 C6, A5, G5, E5 持续 150毫秒
    播放 D5 持续 450毫秒
    播放 E5, G5, A5, C6 持续 150毫秒
    播放 D6 持续 300毫秒
    播放 C6, B5 持续 150毫秒
    播放 A5 持续 600毫秒
}

函数 结尾() {
    播放 E5, D5, C5, B4 持续 150毫秒
    播放 A4 持续 300毫秒
    播放 A4, E5, A5 持续 150毫秒
    播放 A5 持续 900毫秒
}

清屏
显示 "蓝宝石天空" 颜色 #3ddcff

显示 "🌊" 颜色 蓝色
重复 2 次 {
    和弦()
}

显示 "🌱" 颜色 绿色
主歌()
和弦()

显示 "✨" 颜色 金色
重复 2 次 {
    副歌()
}

显示 "🌱" 颜色 绿色
主歌()

显示 "💎" 颜色 紫色
结尾()

显示 "结束 🎵"
