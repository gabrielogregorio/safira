#safira 0.9
# 🦘 超级跳
# 点击输出区。按住 Space 蓄力,松开起跳,Esc 退出。

力量 = 0
进度条 = ""
显示 "按住 Space 蓄力!"

当 真 {
    如果 按下 Esc 那么 结束程序

    如果 按住 Space 那么 {
        增加 1 em 力量
        进度条 = 进度条 + "🟩"
        清屏
        显示 进度条
    }

    在 松开 Space {
        显示 "🦘 跳了 % 米!" 填入 力量
        播放 C5, E5, G5 持续 100毫秒
        力量 = 0
        进度条 = ""
    }

    等待 100 毫秒
}
