#safira 0.9
# ✍️ Math in words

function math receives parameters a, b {
    show "% plus % is %" inserting a, b, a plus b
    show "% minus % is %" inserting a, b, a minus b
    show "% times % is %" inserting a, b, a multiplied by b
    show "% divided by % is %" inserting a, b, a divided by b
    show "% to the power of % is %" inserting a, b, a elevated by b
    show "All of this has the type " + type of a
}

math passing parameters 8, 2
