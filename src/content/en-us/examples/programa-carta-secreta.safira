#safira 0.9
# 💣 Self-destructing letter

create the file "letter.txt"
overwrite "The password is 4815" to the file "letter.txt"

if the file "letter.txt" exists then show read the file "letter.txt"

for each countdown from 3 to 1 {
    show "💣 " + countdown in color red
    wait 1 seconds
}

delete the file "letter.txt"
if the file "letter.txt" does not exist then show "💥 Letter destroyed!"
