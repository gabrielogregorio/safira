#safira 0.9
# Show on screen
# Each show writes on a new line.

show "Hello, world!"
show 10 + 5

# Use + to join text and a variable.
name = "Ana"
show "Hello, " + name

# Use "on this line" to keep writing on the same line.
show on this line "Good "
show on this line "morning!"
show ""

# Pick a color.
show "Blue text" in color blue
