# 📅 Day of the week

print "📅 Type a number from 1 to 3:"
day = the number that the user enters

if day is equal to 1 then {
    print "Sunday 😴"
} else if day is equal to 2 then {
    print "Monday 😩"
} else if day is equal to 3 then {
    print "Tuesday 📚"
} else {
    print "I do not know that day."
}
